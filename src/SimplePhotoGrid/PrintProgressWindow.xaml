<Window x:Class="SimplePhotoGrid.PrintProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preparing to print"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFF3F3F3"
        Closing="OnClosing">

    <StackPanel Margin="18">
        <TextBlock x:Name="HeadingText" Text="Compressing photos for the printer..."
                   TextTrimming="CharacterEllipsis" />

        <ProgressBar x:Name="Bar" Height="18" Margin="0,12,0,0"
                     Minimum="0" Maximum="100" Value="0" />

        <TextBlock x:Name="DetailText" Margin="0,8,0,0" Foreground="#FF666666"
                   FontSize="11" TextTrimming="CharacterEllipsis" Text=" " />

        <Button x:Name="CancelButton" Content="Cancel" Click="OnCancelClick"
                HorizontalAlignment="Right" Margin="0,16,0,0" MinWidth="88" />
    </StackPanel>
</Window>
