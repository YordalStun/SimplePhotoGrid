<Window x:Class="SimplePhotoGrid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:SimplePhotoGrid.Rendering"
        Title="Simple Photo Grid"
        Height="820" Width="1280" MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFF3F3F3">

    <Grid>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Photos -->
            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                <TextBlock DockPanel.Dock="Top" Text="Photos" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                <TextBlock x:Name="CountText" DockPanel.Dock="Top" Foreground="#FF666666"
                           Margin="0,0,0,6" Text="No photos yet" />

                <UniformGrid DockPanel.Dock="Bottom" Columns="4" Rows="2" Margin="0,6,0,0">
                    <Button Content="Add..." Click="OnAddClick" Margin="0,0,4,4" />
                    <Button Content="Remove" Click="OnRemoveClick" Margin="0,0,4,4" />
                    <Button Content="Clear" Click="OnClearClick" Margin="0,0,0,4" />
                    <Button Content="Sort A-Z" Click="OnSortClick" Margin="4,0,0,4" />
                    <Button Content="Move up" Click="OnMoveUpClick" Margin="0,0,4,0" />
                    <Button Content="Move down" Click="OnMoveDownClick" Margin="0,0,4,0" />
                </UniformGrid>

                <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White">
                    <ListBox x:Name="PhotoList" SelectionMode="Extended" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="52" Height="40" Background="#FFEEEEEE">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="1" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Could not be read" Foreground="#FFB00020" FontSize="11"
                                                   Visibility="{Binding Failed, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- Preview -->
            <Border Grid.Row="0" Grid.Column="1" Background="#FF5A5A5A" BorderBrush="#FFCCCCCC" BorderThickness="1">
                <Grid>
                    <Viewbox Stretch="Uniform" Margin="24">
                        <Border Background="White" Effect="{x:Null}">
                            <rendering:VisualHost x:Name="PreviewHost" />
                        </Border>
                    </Viewbox>
                    <TextBlock x:Name="EmptyHint"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontSize="18" TextAlignment="Center"
                               Text="Drag photos here&#x0a;(or use Add...)" />
                </Grid>
            </Border>

            <!-- Settings -->
            <ScrollViewer Grid.Row="0" Grid.Column="2" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Page" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                    <Label Content="Paper size" />
                    <ComboBox x:Name="PaperCombo" SelectionChanged="OnSettingChanged" />
                    <Label Content="Orientation" Margin="0,8,0,2" />
                    <ComboBox x:Name="OrientationCombo" SelectionChanged="OnSettingChanged">
                        <ComboBoxItem Content="Portrait" IsSelected="True" />
                        <ComboBoxItem Content="Landscape" />
                    </ComboBox>
                    <Label Content="Layout" Margin="0,8,0,2" />
                    <ComboBox x:Name="GridCombo" SelectionChanged="OnSettingChanged" />

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <Label Content="Margin (mm)" />
                            <TextBox x:Name="MarginBox" Text="10" TextChanged="OnSettingChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <Label Content="Gap (mm)" />
                            <TextBox x:Name="GapBox" Text="4" TextChanged="OnSettingChanged" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Title" Style="{StaticResource SectionHeader}" />
                    <TextBox x:Name="TitleBox" TextChanged="OnSettingChanged" />
                    <CheckBox x:Name="TitleEveryPageCheck" Content="Show on every page" IsChecked="True"
                              Margin="0,6,0,0" Click="OnSettingChanged" />
                    <Label Content="Title size" Margin="0,8,0,2" />
                    <Slider x:Name="TitleSizeSlider" Minimum="10" Maximum="48" Value="20"
                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged" />

                    <TextBlock Text="Captions" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="CaptionsCheck" Content="Show file name under each photo"
                              IsChecked="True" Click="OnSettingChanged" />
                    <CheckBox x:Name="CaptionExtensionCheck" Content="Include file extension"
                              Margin="0,6,0,0" Click="OnSettingChanged" />
                    <Label Content="Caption size" Margin="0,8,0,2" />
                    <Slider x:Name="CaptionSizeSlider" Minimum="5" Maximum="16" Value="8"
                            TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged" />

                    <TextBlock Text="Other" Style="{StaticResource SectionHeader}" />
                    <CheckBox x:Name="BordersCheck" Content="Thin border around photos"
                              IsChecked="True" Click="OnSettingChanged" />
                    <CheckBox x:Name="PageNumbersCheck" Content="Page numbers (multi-page sheets)"
                              IsChecked="True" Margin="0,6,0,0" Click="OnSettingChanged" />

                    <Button x:Name="ShellButton" Content="Add to Explorer right-click menu"
                            Margin="0,16,0,0" Padding="8,6" Click="OnShellIntegrationClick" />
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom bar -->
            <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="&#x25C0;" Click="OnPreviousPageClick" MinWidth="40" />
                    <TextBlock x:Name="PageText" Text="Page 1 of 1" VerticalAlignment="Center" Margin="10,0" MinWidth="110" />
                    <Button Content="&#x25B6;" Click="OnNextPageClick" MinWidth="40" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Print..." Click="OnPrintClick" Padding="24,6" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0"
                           Foreground="#FF666666" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>

        <Border x:Name="DropOverlay" Background="#CC0078D4" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock Text="Drop photos to add them" Foreground="White" FontSize="28"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
