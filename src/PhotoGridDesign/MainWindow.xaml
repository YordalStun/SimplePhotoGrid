<Window x:Class="PhotoGridDesign.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:SimplePhotoGrid.Rendering"
        Title="Photo Grid Design"
        Height="860" Width="1320" MinHeight="640" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        FontFamily="Segoe UI" FontSize="13"
        Background="#FFF3F3F3">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Templates -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="Design" Style="{StaticResource SectionHeader}"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="TemplateHint" DockPanel.Dock="Bottom" TextWrapping="Wrap"
                       Foreground="#FF666666" FontSize="11" Margin="0,8,0,0" />
            <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White">
                <ListBox x:Name="TemplateList" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="OnSettingChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                           Foreground="#FF777777" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>

        <!-- Preview -->
        <Border Grid.Row="0" Grid.Column="1" Background="#FF5A5A5A"
                BorderBrush="#FFCCCCCC" BorderThickness="1">
            <Grid>
                <Viewbox Stretch="Uniform" Margin="24">
                    <Border Background="White">
                        <shared:VisualHost x:Name="PreviewHost" />
                    </Border>
                </Viewbox>
                <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" FontSize="18" TextAlignment="Center"
                           Text="Drag photos here&#x0a;(or open this from Simple Photo Grid)" />
            </Grid>
        </Border>

        <!-- Customisation -->
        <ScrollViewer Grid.Row="0" Grid.Column="2" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Words" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                <Label Content="Title" />
                <TextBox x:Name="TitleBox" TextChanged="OnSettingChanged" />
                <Label Content="Subtitle" Margin="0,8,0,2" />
                <TextBox x:Name="SubtitleBox" TextChanged="OnSettingChanged" />
                <Label Content="Title size" Margin="0,8,0,2" />
                <Slider x:Name="TitleSizeSlider" Minimum="18" Maximum="90" Value="42"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged" />
                <Label Content="Heading font" Margin="0,8,0,2" />
                <ComboBox x:Name="FontCombo" SelectionChanged="OnSettingChanged" />

                <TextBlock Text="Colours" Style="{StaticResource SectionHeader}" />
                <ComboBox x:Name="ThemeCombo" SelectionChanged="OnSettingChanged" />

                <TextBlock Text="Page" Style="{StaticResource SectionHeader}" />
                <Label Content="Size" />
                <ComboBox x:Name="PaperCombo" SelectionChanged="OnSettingChanged" />
                <Label Content="Orientation" Margin="0,8,0,2" />
                <ComboBox x:Name="OrientationCombo" SelectionChanged="OnSettingChanged">
                    <ComboBoxItem Content="Portrait" IsSelected="True" />
                    <ComboBoxItem Content="Landscape" />
                </ComboBox>

                <TextBlock Text="Photos" Style="{StaticResource SectionHeader}" />
                <CheckBox x:Name="ShadowCheck" Content="Drop shadow" IsChecked="True"
                          Click="OnSettingChanged" />
                <CheckBox x:Name="CaptionsCheck" Content="Show file names" Margin="0,6,0,0"
                          Click="OnSettingChanged" />
                <Label Content="Frame width" Margin="0,8,0,2" />
                <Slider x:Name="FrameSlider" Minimum="0" Maximum="26" Value="8"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged" />
                <Label Content="Corner rounding" Margin="0,8,0,2" />
                <Slider x:Name="RadiusSlider" Minimum="0" Maximum="30" Value="6"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged" />
                <Label Content="Spacing" Margin="0,8,0,2" />
                <Slider x:Name="SpacingSlider" Minimum="0" Maximum="48" Value="14"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged" />
                <Label Content="Tilt (scatter only)" Margin="0,8,0,2" />
                <Slider x:Name="TiltSlider" Minimum="0" Maximum="18" Value="6"
                        TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSettingChanged" />
                <Button Content="Shuffle scatter" Click="OnShuffleClick" Margin="0,10,0,0" />

                <TextBlock Text="Photo list" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="CountText" Foreground="#FF666666" Text="No photos yet" />
                <UniformGrid Columns="2" Margin="0,6,0,0">
                    <Button Content="Add..." Click="OnAddClick" Margin="0,0,3,0" />
                    <Button Content="Clear" Click="OnClearClick" Margin="3,0,0,0" />
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom bar -->
        <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save picture..." Click="OnSaveClick" Padding="16,6" Margin="0,0,8,0" />
                <Button Content="Print..." Click="OnPrintClick" Padding="24,6" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FF666666"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
